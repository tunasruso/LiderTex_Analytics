{
    "builds": [
        {
            "src": "api/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "public/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/main.py"
        },
        {
            "src": "/details",
            "dest": "public/details.html"
        },
        {
            "src": "/plans",
            "dest": "public/plans.html"
        },
        {
            "src": "/(.*)",
            "dest": "public/$1"
        }
    ]
}